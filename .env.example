# Pey (https://portal.mipey.mx/developers)
PEY_API_KEY=
PEY_WEBHOOK_SECRET=

# WhatsApp provider: "meta" (default) or "twilio"
WHATSAPP_PROVIDER=meta

# Meta WhatsApp Cloud API (developers.facebook.com -> your app -> WhatsApp -> API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you invent; type the same value in Meta's webhook configuration
WHATSAPP_VERIFY_TOKEN=
# App settings -> Basic -> App secret (validates incoming webhooks)
META_APP_SECRET=
# Optional: match the version shown in Meta's sample curl command
META_GRAPH_VERSION=v24.0

# Twilio (only when WHATSAPP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+1XXXXXXXXXX

# Public URL of the deployment, no trailing slash (only needed for Twilio signature checks)
PUBLIC_BASE_URL=https://your-app.vercel.app

# Postgres (Neon). Leave empty to use an in-memory store for local development.
DATABASE_URL=

# Optional: log WhatsApp messages instead of sending them
WHATSAPP_DRY_RUN=
# Password for the /setup page and the mock payment endpoint. Both are disabled when empty.
ADMIN_SECRET=
